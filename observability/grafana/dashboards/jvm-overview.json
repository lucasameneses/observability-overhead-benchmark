{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "JVM Memory Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=~\"$job\"}",
          "legendFormat": "{{job}} {{area}} {{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "JVM Memory Max",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_max_bytes{job=~\"$job\"}",
          "legendFormat": "{{job}} {{area}} {{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "JVM GC Pause Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=~\"$job\"}[5m]) * 1000",
          "legendFormat": "{{job}} {{action}} {{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "jvm_threads_current_threads{job=~\"$job\"}",
          "legendFormat": "{{job}} current",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{job=~\"$job\"}",
          "legendFormat": "{{job}} daemon",
          "refId": "B"
        }
      ]
    },
    {
      "title": "JVM Heap Usage %",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg(jvm_memory_used_bytes{job=~\"$job\", area=\"heap\"} / jvm_memory_max_bytes{job=~\"$job\", area=\"heap\"} * 100)",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["jvm", "spring-boot", "observability"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "hide": 0,
        "includeAll": true,
        "label": "Job",
        "multi": true,
        "name": "job",
        "options": [],
        "query": "label_values(up, job)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "JVM Overview",
  "uid": "jvm-overview"
}