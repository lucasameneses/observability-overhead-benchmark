  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=~\"$job\"}[5m])",
          "legendFormat": "{{job}} {{method}} {{uri}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "HTTP Request Latency p50",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(http_server_requests_seconds_bucket{job=~\"$job\"}[5m])) by (le, job, method, uri)) * 1000",
          "legendFormat": "{{job}} {{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "HTTP Request Latency p95",
